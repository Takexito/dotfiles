# Подключается через include из ~/.gitconfig — см. install.sh.
# Здесь только то, что осмысленно и на хосте, и в контейнере.
[user]
	name = takexito
	email = takexito@xaenox.dev

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = zebra
[merge]
	conflictStyle = zdiff3

# gh как источник учётных данных для GitHub. Прописано здесь, а не через
# `gh auth setup-git`: тот пишет в ~/.gitconfig, который в контейнере пропадает
# при пересоздании, и работает только если gh уже авторизован.
# Пустой helper сбрасывает унаследованные — иначе сработает первый попавшийся.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
