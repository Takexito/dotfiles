#!/usr/bin/env bash
# Ищет секреты в staged-изменениях и роняет коммит на находке.
#
# Если gitleaks не установлен, хук ГРОМКО предупреждает, но не блокирует работу:
# молча пропускать проверку опаснее, чем не иметь её вовсе — легко решить, что
# защита работает, когда её нет. Бинарник ставится образом, а не дотфайлами.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '\033[33m!! gitleaks не установлен — staged-изменения НЕ проверены на секреты\033[0m\n' >&2
    exit 0
fi

if ! gitleaks protect --staged --redact --no-banner; then
    printf '\033[31m!! коммит остановлен: в staged-изменениях найдены секреты\033[0m\n' >&2
    printf 'Убери их из индекса. Обход (--no-verify) — только осознанно.\n' >&2
    exit 1
fi
